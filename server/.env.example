# Copy this file to .env and adjust. Never commit the real .env.

# API port
PORT=4000

# Secret used to sign JWTs. If omitted the server generates a random one at
# startup, which invalidates every existing login on restart.
JWT_SECRET=change-me-in-production

# Optional: point at a real MongoDB to persist data.
# If unset, an in-memory MongoDB is used (data resets on every restart).
# MONGODB_URI=mongodb://localhost:27017/smart_factory

# In-memory MongoDB only. MongoDB publishes no native Windows ARM64 builds,
# so on ARM Windows the x64 binary must be downloaded (it runs under emulation).
MONGOMS_ARCH=x86_64
MONGOMS_VERSION=7.0.14
